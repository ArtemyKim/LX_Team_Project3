<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="lx.edu.subwayproject.dao.SubwayRouteDAO">
	
	<!-- 경로 저장 -->
    <insert id="insertRoute" parameterType="lx.edu.subwayproject.dto.RouteDTO" 
            useGeneratedKeys="true" keyProperty="routeId">
        INSERT INTO ROUTE (
            ROUTE_SEQ,
            SCHEDULE_SCHEDULE_ID,
            DEPARTURE_STATION_ID,
            ARRIVAL_STATION_ID
            
        ) VALUES (
            #{routeSeq},
            #{scheduleId},
            #{departureStationId}, 
            #{arrivalStationId}
        )
    </insert>
    
</mapper>