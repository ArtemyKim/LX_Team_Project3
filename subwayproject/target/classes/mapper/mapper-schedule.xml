<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="lx.edu.subwayproject.dao.SubwayScheduleDAO">
	
    <!-- 1. 일정(경로) 등록: 화면에서 받은 '역 이름'으로 'STATION_ID'를 찾아 Insert -->
    <insert id="insertSchedule" parameterType="lx.edu.subwayproject.dto.ScheduleDTO" 
            useGeneratedKeys="true" keyProperty="scheduleId">
        INSERT INTO SCHEDULE (
            TRAVEL_DATE, 
            TRAVEL_TIME, 
            USER_USER_ID, 
            DEPARTURE_STATION_ID, 
            ARRIVAL_STATION_ID
        ) VALUES (
            #{travelDate}, 
            #{travelTime}, 
            #{userId}, 
            <!-- 서브쿼리를 사용하여 역 이름(stationName)으로 STATION_ID를 찾아 저장 -->
            (SELECT STATION_ID FROM STATION WHERE STATION_NAME = #{departureStation.stationName} LIMIT 1),
            (SELECT STATION_ID FROM STATION WHERE STATION_NAME = #{arrivalStation.stationName} LIMIT 1)
        )
    </insert>

    <!-- 2. 객체 매핑을 위한 ResultMap (조회 시 역 이름까지 매핑하기 위함) -->
    <resultMap id="scheduleResultMap" type="lx.edu.subwayproject.dto.ScheduleDTO">
        <id property="scheduleId" column="SCHEDULE_ID" />
        <result property="travelDate" column="TRAVEL_DATE" />
        <result property="travelTime" column="TRAVEL_TIME" />
        <result property="userId" column="USER_USER_ID" />
        
        <!-- 출발역 정보 객체 -->
        <association property="departureStation" javaType="lx.edu.subwayproject.dto.StationDTO">
            <result property="stationId" column="DEPARTURE_STATION_ID" />
            <result property="stationName" column="DEP_STATION_NAME" />
        </association>
        
        <!-- 도착역 정보 객체 -->
        <association property="arrivalStation" javaType="lx.edu.subwayproject.dto.StationDTO">
            <result property="stationId" column="ARRIVAL_STATION_ID" />
            <result property="stationName" column="ARR_STATION_NAME" />
        </association>
    </resultMap>

    <!-- 3. 특정 유저의 일정 목록 조회: JOIN을 통해 ID 뿐만 아니라 역 이름도 함께 조회 -->
    <select id="selectSchedulesByUserId" parameterType="int" resultMap="scheduleResultMap">
        SELECT 
            S.SCHEDULE_ID,
            S.TRAVEL_DATE,
            S.TRAVEL_TIME,
            S.USER_USER_ID,
            S.DEPARTURE_STATION_ID,
            D.STATION_NAME AS DEP_STATION_NAME,
            S.ARRIVAL_STATION_ID,
            A.STATION_NAME AS ARR_STATION_NAME
        FROM SCHEDULE S
        LEFT JOIN STATION D ON S.DEPARTURE_STATION_ID = D.STATION_ID
        LEFT JOIN STATION A ON S.ARRIVAL_STATION_ID = A.STATION_ID
        WHERE S.USER_USER_ID = #{userId}
        ORDER BY S.SCHEDULE_ID DESC
    </select>

</mapper>