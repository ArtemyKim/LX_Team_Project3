<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="lx.edu.subwayproject.dao.UserDAO">

<!-- 아이디 비밀번호 database에 추가 -->

	<select id="selectUserByUserName" parameterType="String" resultType="lx.edu.subwayproject.dto.UserDTO">
	    select
	        USER_ID,
   			USER_NAME,
    		PASSWORD
	    from users
	    where USER_NAME = #{userName}
	</select>
	
	<insert id="addUser" parameterType="lx.edu.subwayproject.dto.UserDTO">
	    insert into users (USER_NAME, PASSWORD)
	    values (#{userName}, #{password})
    </insert>
    
    
	

</mapper>