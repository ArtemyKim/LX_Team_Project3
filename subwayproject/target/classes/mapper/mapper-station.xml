<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="lx.edu.subwayproject.dao.SubwayStationDAO">
	
	<insert id="insertStation" parameterType="lx.edu.subwayproject.dto.StationDTO" 
            useGeneratedKeys="true" keyProperty="stationId">
        INSERT INTO STATION (
            STATION_CODE, 
            STATION_NAME, 
            LINE_NAME
        ) VALUES (
            #{stationCode}, 
            #{stationName}, 
            #{lineName}
        )
    </insert>
    
    <!-- 호선 이름 조회 -->
	<select id="selectLineNames" resultType="String">
		select distinct line_name 
		from station
	</select>
	<!-- 호선 이름 조회 끝 -->

    <!-- ID로 역 조회 -->
    <select id="selectStationById"
            resultType="lx.edu.subwayproject.dto.StationDTO">
        ...
    </select>
    
    <!-- 호선 이름별 역 조회 --> <!-- 최진실 코드 -->
	<select id="selectStationByLineName" resultType="lx.edu.subwayproject.dto.StationDTO">
		select 
			station_id,
			station_name,
			line_order_id
		from station
		where line_name = #{lineName}
	</select>
	
	
	<!-- 여러 역 코드를 이용해 역 조회 -->
	<select id="selectStationsByCodes"
	        resultType="lx.edu.subwayproject.dto.StationDTO">
	
	    SELECT
	        STATION_ID AS stationId,
	        STATION_CODE AS stationCode,
	        STATION_NAME AS stationName,
	        LINE_NAME AS lineName,
	        STATION_MANAGER AS stationManager,
	        LINE_ORDER_ID AS lineOrderId
	
	    FROM STATION
	
	    WHERE STATION_CODE IN
	
	    <foreach collection="list"
	             item="stationCode"
	             open="("
	             separator=","
	             close=")">
	
	        #{stationCode}
	
	    </foreach>
	
	</select>
	
</mapper>