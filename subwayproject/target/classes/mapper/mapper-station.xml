            STATION_CODE AS stationCode,
            STATION_NAME AS stationName,
            LINE_NAME AS lineName

        FROM STATION

        WHERE LINE_NAME = #{lineName}

        ORDER BY STATION_ID
    </select>
    -->
	
</mapper>