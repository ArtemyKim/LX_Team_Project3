<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="lx.edu.subwayproject.dao.SubwayStationDAO">
	
	<insert id="insertStation" parameterType="lx.edu.subwayproject.dto.StationDTO" 
            useGeneratedKeys="true" keyProperty="stationId">
        INSERT INTO STATION (
            STATION_CODE, 
            STATION_NAME, 
            LINE_NAME
        ) VALUES (
            #{stationCode}, 
            #{stationName}, 
            #{lineName}
        )
    </insert>
    	
	
</mapper>