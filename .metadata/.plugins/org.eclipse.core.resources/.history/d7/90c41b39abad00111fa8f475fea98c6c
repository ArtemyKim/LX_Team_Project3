<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="mapper-emp">
	<select id="getEmpById" parameterType="int" resultType="lx.edu.myabweb.to.EmpTO">
		select employee_id empId
			  , last_name lastName
			  , first_name firstName
			  , salary
		from employees
		where employee_id = #{id}
	</select>
	<select id="getEmpListByJobId" parameterType="String" resultType="lx.edu.myabweb.to.EmpTO">
		select employee_id empId
			  , last_name lastName
			  , first_name firstName
			  , salary
		from employees
		where job_id = #{id}
	</select>
	<select id="getEmpListByDeptId" parameterType="int" resultType="lx.edu.myabweb.to.EmpTO">
		select employee_id empId
			  , last_name lastName
			  , first_name firstName
			  , salary
		from employees
		where department_id = #{id}
	</select>
	
	<select id="getDeptList" resultType="int">
		select distinct department_id
		from employees
	</select>

</mapper>